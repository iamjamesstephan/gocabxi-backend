PORT=3000
NODE_ENV=development

# PostgreSQL (DATABASE_URL, if set, overrides the DB_* values)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gocabxi
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# Redis (every key is stored as <REDIS_PREFIX><key>)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=gocabxi:
