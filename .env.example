PORT=3000
NODE_ENV=development

# PostgreSQL (DATABASE_URL, if set, overrides the PG* values)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=gocabxi
PGUSER=postgres
PGPASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# Redis (every key is stored as <REDIS_PREFIX><key>)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=gocabxi:

# Apply migrations and seed system roles on startup (set false if no database is running)
DB_MIGRATE_ON_START=true
